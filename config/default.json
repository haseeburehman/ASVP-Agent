{
  "server": {
    "mode": "http",
    "url": "https://management.example.invalid",
    "registrationPath": "/api/agents/register",
    "heartbeatPath": "/api/agents/heartbeat",
        "deregistrationPath": "/api/agents/deregister",
    "tasksPath": "/api/agents/tasks/poll",
    "resultsPath": "/api/agents/results",
    "adminToken": null,
        "enrollmentToken": null,
        "requestTimeoutMs": 10000
  },
  "agent": {
    "heartbeatIntervalMs": 30000,
    "pollIntervalMs": 10000,
    "logLevel": "info",
    "taskRateLimit": {
      "maxExecutions": 30,
      "windowMs": 300000
    }
  },
  "dashboard": {
    "enabled": false,
    "port": 4180,
    "bindAddress": "127.0.0.1"
  },
  "storage": {
    "identityPath": "var/identity.json",
    "statusPath": "var/status.json",
    "taskReplayLedgerPath": "var/task-replay-ledger.json",
    "taskJournalPath": "var/task-journal.json",
    "queueDir": "var/queue",
    "maxQueueSizeBytes": 524288000,
    "maxQueueItems": 10000,
    "maxItemAgeMs": 604800000
  },
  "retry": {
    "initialDelayMs": 1000,
    "maximumDelayMs": 30000
  },
  "collectors": {
    "upload": {
      "intervalMs": 15000,
      "uploadConcurrency": 3,
      "maxPayloadWarningBytes": 10485760,
      "authFailureThreshold": 5
    },
    "noop": {
      "timeoutMs": 5000,
      "concurrency": 2
    },
    "os-info": {
      "timeoutMs": 25000,
      "concurrency": 1,
      "patchCheckTimeoutMs": 15000
    },
    "apps": {
      "timeoutMs": 20000,
      "concurrency": 1,
      "maxItems": 500
    },
    "sca-deps": {
      "timeoutMs": 30000,
      "concurrency": 1,
      "scanPaths": [],
      "maxDepth": 6,
      "maxManifests": 200
    },
    "containers": {
      "timeoutMs": 60000,
      "concurrency": 1,
      "maxContainers": 20,
      "maxPackagesPerContainer": 500
    },
    "local-ports": {
      "timeoutMs": 15000,
      "concurrency": 1
    },
    "compliance-checks": {
      "timeoutMs": 45000,
      "concurrency": 1,
      "commandTimeoutMs": 20000
    },
    "users-groups": {
      "timeoutMs": 15000,
      "concurrency": 1
    },
    "antivirus-status": {
      "timeoutMs": 20000,
      "concurrency": 1
    },
    "process-summary": {
      "timeoutMs": 15000,
      "concurrency": 1,
      "maxItems": 250
    },
    "network-config": {
      "timeoutMs": 15000,
      "concurrency": 1,
      "maxItems": 100
    },
    "disk-security": {
      "timeoutMs": 20000,
      "concurrency": 1,
      "maxItems": 100
    },
    "baseline": {
      "rescanIntervalMs": 86400000
    }
  }
}
