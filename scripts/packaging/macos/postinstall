#!/bin/sh
set -eu
binary='/Library/Application Support/ASVP Agent/asvp-agent'
config='/Library/Application Support/ASVP Agent/config/default.json'
enrollment_file='/Library/Application Support/ASVP Agent/enrollment'
chmod 0755 "$binary"
mkdir -p '/Library/Application Support/ASVP Agent/var'
chmod 0700 '/Library/Application Support/ASVP Agent/var'

server_url=${ASVP_SERVER_URL:-}
enrollment_token=${ASVP_ENROLLMENT_TOKEN:-}
if [ -f "$enrollment_file" ]; then
  server_url=$(sed -n '1p' "$enrollment_file")
  enrollment_token=$(sed -n '2p' "$enrollment_file")
fi

if [ -n "$server_url" ] && [ -n "$enrollment_token" ]; then
  input_file=$(mktemp '/Library/Application Support/ASVP Agent/enrollment.XXXXXX')
  chmod 0600 "$input_file"
  printf '%s\n%s\n' "$server_url" "$enrollment_token" > "$input_file"
  "$binary" --config "$config" enroll --input-file "$input_file"
  rm -f "$input_file" "$enrollment_file"
  printf '%s\n' 'ASVP Agent enrollment saved. Installing and starting its launchd service now.'
  "$binary" --config "$config" service install
else
  printf '%s\n' \
    'ASVP Agent installed but not started because enrollment information is missing.' \
    'Set both ASVP_SERVER_URL and ASVP_ENROLLMENT_TOKEN during installation, or place the server URL and token on separate lines in the enrollment file before installation.' \
    "Enrollment file: $enrollment_file" \
    'Manual setup:' \
    "  sudo '$binary' --config '$config' enroll" \
    "  sudo '$binary' --config '$config' service install"
fi
exit 0
